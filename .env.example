BASE_URL=https://mi.grcinspections.com/
USER_NAME=
USER_PASSWORD=
# Optional: limit dispatch-details.spec.ts during development, for example JOB_LIMIT=1
JOB_LIMIT=
# Optional: zero-based starting position, for example JOB_OFFSET=6 selects the seventh Job Number
JOB_OFFSET=
# Optional exact Job Number selection, for example JOB_NUMBER=SICK ETC.
JOB_NUMBER=
# Optional date used by dispatch-details.spec.ts in YYYY-MM-DD format
DISPATCH_DATE=
# Maximum wait for all Images cells to become View or No images (default: 8 minutes)
IMAGES_LOADING_TIMEOUT_MS=480000
