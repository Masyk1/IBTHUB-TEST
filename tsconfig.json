{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@ui/*": ["./specs/ui/*"],
      "@config/*": ["./specs/config/*"],
      "@utils/*": ["./utils/*"]
    }
  },
  "include": ["specs/**/*.ts", "utils/**/*.ts", "playwright.config.ts", "eslint.config.js"],
  "exclude": ["node_modules", "playwright-report", "test-results", "artifacts", ".state"]
}
